-- Initial schema: subscribed feeds. Timestamps are epoch-millis; the mapper converts to
-- kotlinx-datetime Instant at the boundary. `url` is UNIQUE so a feed can't be subscribed twice.
CREATE TABLE Feed (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    url TEXT NOT NULL UNIQUE,
    title TEXT NOT NULL,
    site_url TEXT,
    description TEXT,
    last_fetched_at INTEGER
);
