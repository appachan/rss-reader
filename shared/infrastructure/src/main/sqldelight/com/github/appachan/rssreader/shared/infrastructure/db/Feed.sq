-- Subscribed feeds. Timestamps are epoch-millis; the mapper converts to kotlinx-datetime Instant at
-- the boundary. `url` is UNIQUE so a feed can't be subscribed twice.
CREATE TABLE Feed (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    url TEXT NOT NULL UNIQUE,
    title TEXT NOT NULL,
    site_url TEXT,
    description TEXT,
    last_fetched_at INTEGER
);

selectAll:
SELECT * FROM Feed ORDER BY id;

selectById:
SELECT * FROM Feed WHERE id = ?;

selectByUrl:
SELECT * FROM Feed WHERE url = ?;

insertFeed:
INSERT INTO Feed(url, title, site_url, description, last_fetched_at)
VALUES (?, ?, ?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

deleteById:
DELETE FROM Feed WHERE id = ?;
